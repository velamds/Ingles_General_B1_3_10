incorrect", "contents": [{"content": "in", "type": "text"}]}, {"type": "post_question", "contents": {"content": "with any preparation when an accident happens. Can you continue if you see a partner who just broke a", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "on", "type": "text"}], "id": 1}], "id": 0}, {"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "bound", "type": "text"}]}, {"type": "post_question", "contents": {"content": "? I don't think so. Perhaps people in the kitchen can't easily get", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "bone", "type": "text"}], "id": 1}], "id": 1}, {"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "alone", "type": "text"}]}, {"type": "post_question", "contents": {"content": "in a difficult situation. In those cases, it is necessary to provide a lot of training.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "along", "type": "text"}], "id": 1}], "id": 2}], "template_override": 2, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": "Derek is writing to a newspaper about accidents in the kitchen. What does he say?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: \n<span class=\"bullet\">Proofread the sentence.</span> \n<span class=\"bullet\">Click on the incorrect word.</span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.\n</span> <span class=\"bullet\">Use capital letters where necessary.</span>", "type": "text"}]}, {"content": 2, "type": "template_override"}], "id": 9, "type": "GIW"}, {"questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "id": 10, "type": "RSLT"}, {"questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn8le10ob05re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " \nA story about a kitchen mishap!\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self Assessment.", "type": "text"}]}], "id": 11, "type": "DWS"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"type": "audio", "template_override": 1, "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le10ob05re2img05.jpg", "audiosrc": "engenn8le10ob05re2aud01", "images": [{"time": "0", "image": "engenn8le10ob05re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le10ob05re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Everyone, Our Spicy Rice Night is coming up soon and we don't want any mishaps in the kitchen. I think what I want to get at is the fact that accidents happen. As I see it, we have to get on with our work without any unauthorized people in the kitchen.<br/><span class=\"strong\">Tanya</span>: Can you clarify who is authorized?<br/>\n<span class=\"strong\">Vanessa</span>: I feel we should get down to essential personnel - cooks and waiters only."}, {"time": "21700", "image": "engenn8le10ob05re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Daniel</span>: Are you saying that means no entertainers?<br/><span class=\"strong\">Vanessa</span>: Yes. I am having a heated tent set up for them just out the side door.<br/>\n<span class=\"strong\">Tanya</span>: So that's where they'll be between sets? <br/><span class=\"strong\">Vanessa</span>: Yes. It's quite obvious that we have to get on with our work and watch out for each other. When things get rushed, people don't clean up spills that can result in a fall.  Burns and scalds are also more common when it's busy."}, {"time": "45500", "image": "engenn8le10ob05re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Tanya</span>: Can you tell us how to prevent accidents?<br/>\n<span class=\"strong\">Vanessa</span>: I'm certain you'll want to rush, but we'll get by if you don't. There are lots of hot liquids in a busy kitchen. Fires happen when people aren't paying attention. So, I think we all have to look after each other and strive to get along under pressure.<br/><span class=\"strong\">Daniel</span>: So you think that we should stay calm?<br/>\n<span class=\"strong\">Vanessa</span>: Exactly. It will be noisy and chaotic. However, we want to avoid burned fingers and broken bones!"}]}}], "id": 1}, {"id": 2, "template_override": 1, "title": "", "_data": [], "type": "static", "contents": [{"type": "p", "value": "<span class=\"strong\">Vanessa</span>: Everyone, Our Spicy Rice Night is coming up soon and we don't want any mishaps in the kitchen. I think what I want to get at is the fact that accidents happen. As I see it, we have to get on with our work without any unauthorized people in the kitchen.<br/><span class=\"strong\">Tanya</span>: Can you clarify who is authorized?<br/>\n<span class=\"strong\">Vanessa</span>: I feel we should get down to essential personnel - cooks and waiters only.<br/><span class=\"strong\">Vanessa</span>: Everyone, Our Spicy Rice Night is coming up soon and we don't want any mishaps in the kitchen. I think what I want to get at is the fact that accidents happen. As I see it, we have to get on with our work without any unauthorized people in the kitchen.<br/><span class=\"strong\">Tanya</span>: Can you clarify who is authorized?<br/>\n<span class=\"strong\">Vanessa</span>: I feel we should get down to essential personnel - cooks and waiters only.<br/><span class=\"strong\">Tanya</span>: Can you tell us how to prevent accidents?<br/>\n<span class=\"strong\">Vanessa</span>: I'm certain you'll want to rush, but we'll get by if you don't. There are lots of hot liquids in a busy kitchen. Fires happen when people aren't paying attention. So, I think we all have to look after each and strive to get along under pressure.<br/><span class=\"strong\">Daniel</span>: So you think that we should stay calm?<br/>\n<span class=\"strong\">Vanessa</span>: Exactly. It will be noisy and chaotic. However, we want to avoid burned fingers and broken bones!"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Vanessa and the Cooking Accident", "type": "lesson_name"}, {"content": "Mishaps in the Kitchen", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe  events through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le10ob05re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Exchanging Opinions", "type": "heading"}, {"content": "When you express an opinion, you give your ideas on a topic.  You can use some inseparable phrasal verbs when you give opinions.", "type": "describer"}, {"content": "Some phrases we use to give opinions are : <br/> <span class=\"italic\">So you think ...</span>, <span class=\"italic\">Honestly, ...</span>, <span class=\"italic\">I think ...</span>, and  <span class=\"italic\">I guess ...</span><br/><br/>  You use phrasal verbs when you want to be less formal. They are very common in spoken English.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Phrasal Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">get by<br/><br/>get along<br/><br/>get on with<br/><br/>get down to<br/><br/>get at</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"survive<br/><br/>be pleasant and not argue<br/><br/>do; continue doing<br/><br/>be serious about <br/><br/>make a point\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": " I think what I want <span class=\"strong\">to get at</span> is the fact that accidents happen. ", "type": "example"}, {"content": " As I see it, we have <span class=\"strong\">to get on with</span> our work without any unauthorized people in the kitchen.", "type": "example"}, {"content": "I feel we should <span class=\"strong\">get down to</span> essential personnel - cooks and waiters only.", "type": "example"}, {"content": "It's quite obvious that we have <span class=\"strong\">to get on with</span> our work and watch out for each other.", "type": "example"}, {"content": "I'm certain you'll want to rush, but we'll <span class=\"strong\">get by</span> if you don't. ", "type": "example"}, {"content": " I think we all have to look after each and strive <span class=\"strong\">to get along</span> under pressure.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Asking for Clarification", "type": "heading"}, {"content": "You ask for clarification when you want more details on what the other person is talking about. ", "type": "describer"}, {"content": "You ask for clarification when it is not clear what the other person is referring to. You ask the other person to be more specific by giving you more information. <br/><br/>  You can use a question at the beginning of a statement or question to ask for clarification like: <span class=\"italic\">Don't you think it sounds a bit too intense?</span><br/><br/> Questions within sentences are called embedded questions. <br/><br/>  Example: <br/> <span class=\"strong\">Simple question</span>: <span class=\"italic\">What are you going to do after dinner?</span><br/> <span class=\"strong\">Embedded question</span>: <span class=\"italic\">Do you know what you're going to do after dinner?</span><br/><br/>  Look at the chart below for an explanation on how to make embedded questions.", "type": "text"}, {"content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\">Main Question</div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\">Embedded Question</div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Do you know ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Do you remember ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Can you tell me ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Could you tell me ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ ... ?\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "You can also use a direct question.<br/> <span class=\"strong\">Example</span>: <span class=\"italic\">Is that a hint?</span><br/><br/>  Direct questions go straight to the point. Sometimes they are used to be light-hearted or to be funny.<br/><br/>  <span class=\"strong\">Peter</span>: <span class=\"italic\">I'm really hungry now!</span><br/> <span class=\"strong\">Sally</span>: <span class=\"italic\">You mean there are times when you're not?</span>", "type": "text"}, {"content": "Can you clarify who is authorized?", "type": "example"}, {"content": "Are you saying that means no entertainers?", "type": "example"}, {"content": "So that's where they'll be between sets? ", "type": "example"}, {"content": "Can you tell us how to prevent accidents?", "type": "example"}, {"content": "So you think that we should stay calm?", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to face up to", "type": "name"}, {"content": "to accept that a difficult situation exists", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: She has to face up to the fact that she will be alone.", "type": "example"}, {"content": "engenn8le10ob05aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about kitchen safety.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "mishap", "type": "name"}, {"content": "an unfortunate accident", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The event is coming up and we don't want any mishaps in the kitchen.", "type": "example"}, {"content": "engenn8le10ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "unauthorized", "type": "name"}, {"content": "without having official permission", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: We have to get on with our work without any unauthorized people in the kitchen. ", "type": "example"}, {"content": "engenn8le10ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "tent", "type": "name"}, {"content": "portable shelter made of fabric or other material stretched over a supporting framework", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I am having a heated tent set up for them just out the side door.", "type": "example"}, {"content": "engenn8le10ob05aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "chaotic", "type": "name"}, {"content": "a condition of great disorder and confusion", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: It will be noisy and chaotic.", "type": "example"}, {"content": "engenn8le10ob05aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "burn", "type": "name"}, {"content": "an injury caused by fire or heat seriously affecting the skin", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We want to avoid burns on our hands and fingers.", "type": "example"}, {"content": "engenn8le10ob05aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "scald", "type": "name"}, {"content": "an injury caused by a boiling liquid", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Burns and scalds are also more common when it's busy.", "type": "example"}, {"content": "engenn8le10ob05aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bone", "type": "name"}, {"content": "one of the parts of the skeleton of an animal or person", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We want to avoid broken bones!", "type": "example"}, {"content": "engenn8le10ob05aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Write a story about a kitchen mishap.", "type": "text"}, {"content": "It could have happened to you or to a family member or it can be fictional.", "type": "text"}, {"content": "Make your story 250 words long.", "type": "text"}, {"content": "Explain the situation and what happened using a lot of detail.", "type": "text"}, {"content": "In your story, include at least 10 phrasal verbs.", "type": "text"}, {"content": "Get into groups, tell your story to the group in your own words.", "type": "text"}, {"content": "Vote on who had the worst mishap.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write a story of 250 words.", "type": "text"}, {"content": "I explain the situation and what happened in detail.", "type": "text"}, {"content": "I use at least 10 phrasal verbs correctly. ", "type": "text"}, {"content": "I explain my story authentically.", "type": "text"}]}], "type": "sena"}