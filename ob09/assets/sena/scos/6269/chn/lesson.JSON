rect": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "sure", "type": "text"}], "id": 1}], "id": 3}], "_data": [{"type": "instructions", "contents": [{"content": " What's your opinion?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Listen to the audio. Type in the missing words. ", "type": "text"}]}], "stimuli_ids": [], "template_override": 1, "type": "TYP", "id": 10}, {"questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "stimuli_ids": [], "template_override": 1, "type": "RSLT", "id": 11}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "id": 0, "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"type": "audio", "template_override": 1, "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le10ob09re2img05.jpg", "audiosrc": "engenn8le10ob09re2aud01", "images": [{"time": "0", "image": "engenn8le10ob09re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le10ob09re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Okay, I suggest that you sit there while I go on with dinner.<br/>\n<span class=\"strong\">Sally</span>: I can throw out the onions and wash the cutting board.<br/>\n<span class=\"strong\">Vanessa</span>: You should use these rubber gloves while you're doing that.<br/>\n<span class=\"strong\">Sally</span>: I can doodle some ideas for your booklet while you're cooking. We could put some of your words of wisdom in the steam coming from pots.<br/>\n<span class=\"strong\">Vanessa</span>: You mean like always cut away from you."}, {"time": "20000", "image": "engenn8le10ob09re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Sally</span>: I don't think that we can get out of using that one!<br/>\n<span class=\"strong\">Vanessa</span>: I absolutely agree with you. I'm pretty sure that you could get into telling better anecdotes to for a booklet than I could.<br/>\n<span class=\"strong\">Sally</span>: I'm certain that you know much more about how to get through a recipe than I do. Like: Boil the rice! Mash the potatoes! Grind the pepper! Then some chives can be sprinkled on the salad!<br/>\n<span class=\"strong\">Vanessa</span>: I believe that you are trying to get away with mocking me Sally!"}, {"time": "46000", "image": "engenn8le10ob09re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: It's quite obvious that I revere your cooking skills when you get down to it. So, I'm just trying to be funny.<br/>\n<span class=\"strong\">Vanessa</span>: Did you take a pain-killer? You sound a little loopy! Have some orange juice!<br/>\n<span class=\"strong\">Sally</span>: I'll just sit here. You talk. <br/>\n<span class=\"strong\">Vanessa</span>: Okay. The spices should be chopped up so the rice will smell and taste nice. Some sunflower seeds can be roasted to toss in later.<br/>\n<span class=\"strong\">Sally</span>: I'm so happy you can salvage dinner. I'm starving!"}]}}], "id": 1}]}], "_data": [{"type": "metadata", "contents": [{"content": "Vanessa and the Cooking Accident", "type": "lesson_name"}, {"content": "Salvaging the Dinner", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": " Describe  events through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le10ob09re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Passive Modals and The Imperative to Talk About Food", "type": "heading"}, {"content": "You use modal verbs to add meaning to other verbs. They come before the dictionary form (Infinitive without \u2018to') of the main verb.  Modal verbs can add meaning connected with certainty or obligation.", "type": "describer"}, {"content": "You can use modal verbs in the passive voice. <br/> You use the passive voice when you want to focus on the receiver of the action, rather than the \u2018doer' of the action. <br/><br/>  Here is the structure of a passive sentence:<br/><br/>  Subject + to be + past participle<br/><br/>  For example:<br/>  <span class=\"italic\">Then some chives <span class=\"strong\">are sprinkled</span> on the salad!</span>", "type": "text"}, {"content": "You can add a modal verb before the To be.<br/><br/>  Subject + modal + to be + past participle<br/><br/>  For example:<br/><span class=\"italic\">Then some chives <span class=\"strong\">can be sprinkled</span> on the salad!</span><br/><br/>   Here the sentence now has an additional meaning of possibility, thanks to the modal <span class=\"strong\">can</span>.", "type": "text"}, {"content": "When you are cooking, or talking about how to cook, you can also use the imperative.<br/> The imperative is used when giving directions.<br/> The subject \u2018you' is understood and left out.<br/><br/>  Example:<br/> <span class=\"italic\">Boil the vegetables</span>. = <span class=\"italic\">You boil the vegetables</span>.<br/><br/> By leaving out \u2018you' the statement becomes stronger and the focus is shifted to the verb.", "type": "text"}, {"content": "The spices should be chopped up so the rice will smell and taste nice.", "type": "example"}, {"content": " Some sunflower seeds can be roasted to toss in later. ", "type": "example"}, {"content": "Then some chives can be sprinkled on the salad!", "type": "example"}, {"content": "Boil the rice!", "type": "example"}, {"content": "Mash the potatoes!", "type": "example"}, {"content": "Grind the pepper!", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Expressing Opinions", "type": "heading"}, {"content": "When you express an opinion, you give your ideas on a topic.  You can use some inseparable phrasal verbs when you give opinions.", "type": "describer"}, {"content": "Some phrases we use to give opinions are: <br/> <span class=\"italic\">I don't think ...</span>, <span class=\"italic\">I'm certain ...</span>, <span class=\"italic\">I believe ...</span>, <span class=\"italic\">It's quite obvious ...</span>,  and <span class=\"italic\">I'm pretty sure ...</span><br/><br/>  You use phrasal verbs when you want to be less formal. They are very common in spoken English.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Phrasal Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">get out of<br/><br/>   get into<br/><br/>  get through<br/><br/>  get get away with <br/><br/> get down to</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"be released from an obligation<br/><br/>  be enthusiastic about<br/><br/>  continue to completion<br/><br/>  receive no punishment for<br/><br/>  have a good look at\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "I don't think that we can <span class=\"strong\">get out of</span> using that one!", "type": "example"}, {"content": "I'm pretty sure that you could <span class=\"strong\">get into</span> telling better anecdotes for a booklet than I could.", "type": "example"}, {"content": "I'm certain that you know much more about how to <span class=\"strong\">get through</span> a recipe than I do. ", "type": "example"}, {"content": "I believe that you are trying <span class=\"strong\">to get away with</span> mocking me, Sally!", "type": "example"}, {"content": "It's quite obvious that I revere your cooking skills when you <span class=\"strong\">get down to</span> it.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to throw out", "type": "name"}, {"content": "to reject or discard", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I can throw out the onions and wash the cutting board.", "type": "example"}, {"content": "engenn8le10ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you are cooking with a friend.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "words of wisdom", "type": "name"}, {"content": "piece of advice coming from a wise person", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: We could put some of your words of wisdom in the steam coming from pots.", "type": "example"}, {"content": "engenn8le10ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to doodle", "type": "name"}, {"content": "to draw or sketch something without a specific purpose", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I can doodle some ideas for your booklet.", "type": "example"}, {"content": "engenn8le10ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "steam", "type": "name"}, {"content": "the vapor produced by water", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You can see the steam from the pots.", "type": "example"}, {"content": "engenn8le10ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to call for", "type": "name"}, {"content": "to require something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: This job calls for patience.", "type": "example"}, {"content": "engenn8le10ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "anecdote", "type": "name"}, {"content": "a personal story of an interesting incident", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm pretty sure that you could get into telling better anecdotes for a booklet.", "type": "example"}, {"content": "engenn8le10ob09aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to mock", "type": "name"}, {"content": "to imitate or make fun of someone", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I believe that you are trying to get away with mocking me, Sally!", "type": "example"}, {"content": "engenn8le10ob09aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "loopy", "type": "name"}, {"content": "bizarre or crazy", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You sound a little loopy! ", "type": "example"}, {"content": "engenn8le10ob09aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to revere", "type": "name"}, {"content": "to feel great respect or admiration for somebody/something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: It's quite obvious that I revere your cooking skills.", "type": "example"}, {"content": "engenn8le10ob09aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to salvage", "type": "name"}, {"content": "to rescue", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I'm so happy you can salvage dinner.", "type": "example"}, {"content": "engenn8le10ob09aud10", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "In pairs, research the different types of food idioms, select two and make a powerpoint presentation about these food idioms.", "type": "text"}, {"content": "Each student is responsible for presenting two idioms.", "type": "text"}, {"content": "Idioms must contain an explanation of the idiom and an example of how to use it.", "type": "text"}, {"content": "Use a conversation, pictures, or other media to explain the idioms meaning.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I research food idioms online.", "type": "text"}, {"content": "I work together with a partner to explain selected food idioms in a clear and concise manner.", "type": "text"}, {"content": "I present my idioms to the class.", "type": "text"}]}], "type": "sena"}