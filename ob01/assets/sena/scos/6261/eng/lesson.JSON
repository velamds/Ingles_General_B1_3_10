pts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn8le10ob01re2img01.jpg"}, {"text": "Hey Sal,<br/><br/>\nDropping you an e-mail to see how things are going. Work is finished for the day, thank goodness! To be honest, so much wine is guzzled by patrons on some nights that I am glad they are whisked away by cab! Those who are ushered to late movies must find it hard to concentrate! To my mind, the ones who are escorted to night clubs are better off. Alcohol is burned off quite quickly on the dance floor, as far as I know.", "id": 1, "time": "100", "image": "engenn8le10ob01re2img01.jpg"}, {"text": "Invitations to our Spicy Rice Night are sent. I think all that's left is to get ready for it! In my opinion the costumes and decorations that are chosen will make it quite a spectacle! Last week you said you saw an interesting spice shop in Boston. Do you know what it was called? It was downtown somewhere. Can you tell me where to find it? I know you said you were walking.", "id": 2, "time": "26400", "image": "engenn8le10ob01re2img02.jpg"}, {"text": "Do you recall what the name of the street was? What about the spices? Did you see any from India? I'd love to pick up some for the extravaganza. Let's go to Boston to find it. You said you had a day off this week. Can you call me and tell me what day that is?<br/><br/>It's late and I am so tired!!!<br/><br/>Vanessa", "id": 3, "time": "51200", "image": "engenn8le10ob01re2img05.jpg"}], "audiosrc": "engenn8le10ob01re2aud01", "coverimg": "engenn8le10ob01re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}