", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": "Instructions:Listen to the audio. Select the correct answer.", "type": "text"}, {"content": " You have 2 attempts to submit your answers.", "type": "text"}, {"content": "engenn8le10ob03re2aud01", "type": "audio"}], "type": "post_instructions"}], "questions": [{"_data": [{"contents": [{"content": "How does Vanessa liven up the event?", "type": "text"}], "type": "question"}, {"content": "secondary_1", "type": "objective"}], "id": 0, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "By having customers select their favorite menus", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "By providing a spicy menu and a special winter celebration", "type": "text"}], "id": 1}, {"correct": 0, "selected": 0, "_data": [{"content": "By reading cooking books", "type": "text"}], "id": 2, "text": ""}]}, {"_data": [{"contents": [{"content": "How did she come up with the idea of spicy food?", "type": "text"}], "type": "question"}, {"content": "secondary_1", "type": "objective"}], "id": 1, "responses": [{"correct": 1, "selected": 0, "_data": [{"content": "She discovered that customers loved it", "type": "text"}], "id": 0}, {"correct": 0, "selected": 0, "_data": [{"content": "She found it on the Internet", "type": "text"}], "id": 1}, {"correct": 0, "selected": 0, "_data": [{"content": "A friend told her about it", "type": "text"}], "id": 2, "text": ""}]}, {"_data": [{"contents": [{"content": "What did she have to go through to 